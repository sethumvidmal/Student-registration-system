# Copy to .env and adjust. docker compose reads .env automatically.
SPRING_PROFILES_ACTIVE=dev

# MySQL running on the host machine
DB_PORT=3306
DB_NAME=institute_crm
DB_USERNAME=root
DB_PASSWORD=12345

# Min 32 chars each
JWT_SECRET=dev-access-secret-change-me-0123456789abcdef
REFRESH_JWT_SECRET=dev-refresh-secret-change-me-0123456789abcdef
